# Fonts
font-family = "MesloLGS Nerd Font"
font-size = 10

shell-integration = zsh
resize-overlay = never

unfocused-split-opacity = 0.5

cursor-style = block

adjust-cell-height = -15%
shell-integration-features = no-cursor

# Mouse
mouse-hide-while-typing = true
mouse-scroll-multiplier = 2

working-directory = inherit

# Theme
theme = Tomorrow Night

# keybindings
keybind = clear
keybind = super+shift+i=inspector:toggle
keybind = super+shift+right=next_tab
keybind = super+shift+left=previous_tab
keybind = super+shift+z=toggle_split_zoom
keybind = super+shift+comma=move_tab:-1
keybind = super+shift+period=move_tab:1
keybind = super+shift+c=copy_to_clipboard
keybind = super+shift+r=reload_config
keybind = super+shift+v=paste_from_clipboard

# Window
gtk-single-instance = true
gtk-titlebar = false
gtk-tabs-location = bottom
gtk-wide-tabs = false
fullscreen = non-native
window-decoration = none
window-padding-x = 2
window-padding-y = 2
window-padding-balance = true


# Other
# Herdr copies mouse selections through OSC 52; allow terminal apps to update
# the system clipboard so Herdr's "copied" notification is pasteable outside it.
clipboard-write = allow
copy-on-select = clipboard
